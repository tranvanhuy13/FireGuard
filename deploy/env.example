# Copied to /opt/fireguard/.env on the VM by gcp-setup.sh. Not committed.
REGISTRY=asia-southeast1-docker.pkg.dev/PROJECT_ID/fireguard
TAG=latest
DOMAIN=34.0.0.1.sslip.io
GCS_BUCKET=PROJECT_ID-fireguard
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
AUTH_DEV_MODE=false
STREAM_TOKEN_SECRET=change-me-long-random

# Aiven MySQL: Overview > Connection information. No secrets in this template.
MYSQL_HOST=
MYSQL_PORT=
MYSQL_DATABASE=fireguard
MYSQL_USER=
MYSQL_PASSWORD=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=300
# Absolute existing CA file on the Docker host; mounted read-only into the container.
MYSQL_SSL_CA_HOST_PATH=/home/you/.fireguard/certs/aiven-ca.pem
