# Copy to ~/.fireguard/local.env (outside the repo) and fill in. Never commit the real file.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-long-random
S3_BUCKET=fireguard
S3_ACCESS_KEY=fireguard-backend
S3_SECRET_KEY=change-me-long-random
# Public S3 API origin for Zalo image links; route it to MinIO port 9000.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_SNAPSHOT_URL_TTL_SECONDS=86400
# Optional bot overrides; blank/missing values fall back to saved UI settings.
# ZALO_BOT_TOKEN=
# ZALO_CHAT_ID=
# ZALO_ENABLED=true
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_ENABLED=true
# Absolute path to the YOLO model (not in git); uploaded to MinIO on first start
MODEL_SEED=/home/you/.fireguard/best.pt
# Login OTP e-mails (backend/auth/utils.py): a Gmail address + an App Password
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# true = write the OTP to the backend log instead of e-mailing it (local testing)
AUTH_DEV_MODE=true
# Random secret so camera/WebSocket stream tokens survive a restart: openssl rand -hex 32
STREAM_TOKEN_SECRET=change-me-long-random
# BIND=0.0.0.0 to open the site to your LAN
BIND=127.0.0.1
HTTP_PORT=8080
MINIO_CONSOLE_PORT=9101
