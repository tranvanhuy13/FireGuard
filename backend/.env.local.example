# Copy to .env.local for development. Shell environment variables take priority.
# Relative model paths are resolved against the backend directory.
MODEL_PATH=best.pt

# Periodic captures only; event/video snapshots retain their existing lifecycle.
PERIODIC_SNAPSHOT_RETENTION_DAYS=7
SNAPSHOT_CLEANUP_INTERVAL_SECONDS=3600

# Zalo direct S3 links. Set the actual public S3 API origin (not the Console).
# Existing S3_ENDPOINT/BUCKET/ACCESS_KEY/SECRET_KEY must also be configured.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_SNAPSHOT_URL_TTL_SECONDS=86400

# Optional bot credentials; process/.env.local/.env values take priority over UI settings.
# Unset values fall back to SQLite. Explicit *_ENABLED=false disables that bot.
# ZALO_BOT_TOKEN=
# ZALO_CHAT_ID=
# ZALO_ENABLED=true
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_ENABLED=true
