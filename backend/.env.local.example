# Copy to .env.local for development. Shell environment variables take priority.
# Relative model paths are resolved against the backend directory.
MODEL_PATH=best.pt

# Periodic captures only; event/video snapshots retain their existing lifecycle.
PERIODIC_SNAPSHOT_RETENTION_DAYS=7
SNAPSHOT_CLEANUP_INTERVAL_SECONDS=3600

# Zalo direct S3 links. Set the actual public S3 API origin (not the Console).
# Existing S3_ENDPOINT/BUCKET/ACCESS_KEY/SECRET_KEY must also be configured.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_SNAPSHOT_URL_TTL_SECONDS=86400

# Supabase Storage: see docs/SUPABASE_STORAGE.md. Use backend-only S3 keys.
# Full URL (including the API path) selects the URL-capable S3 adapter.
# S3_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
# S3_PUBLIC_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
# S3_BUCKET=fireguard
# S3_REGION=us-west-2
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Optional bot credentials; process/.env.local/.env values take priority over UI settings.
# Unset values fall back to MySQL. Explicit *_ENABLED=false disables that bot.
# ZALO_BOT_TOKEN=
# ZALO_CHAT_ID=
# ZALO_ENABLED=true
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# TELEGRAM_ENABLED=true

# Aiven MySQL: Overview > Connection information. No secrets in this template.
MYSQL_HOST=
MYSQL_PORT=
MYSQL_DATABASE=fireguard
MYSQL_USER=
MYSQL_PASSWORD=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=300
MYSQL_SSL_CA=certs/aiven-ca.pem
# Render: upload Secret File aiven-ca.pem and set MYSQL_SSL_CA=/etc/secrets/aiven-ca.pem.

# Shared backend-only API session signing secret (one-hour sessions).
# Set the same strong value on every backend worker.
# AUTH_SESSION_SECRET=
